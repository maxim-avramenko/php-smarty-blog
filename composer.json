{
    "name": "php-smarty-blog/app",
    "description": "Simple PHP + Smarty + MySQL blog",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "smarty/smarty": "^5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
